<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <variable name="logDir" value="logs" />

  <targets>
    <target xsi:type="Console"
            name="console"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner= ${exception:format=tostring}}" />

    <!-- logDir задаётся в Program.cs = ContentRoot/logs; createDirs создаёт папку при первой записи -->
    <target xsi:type="File"
            name="file"
            fileName="${var:logDir}/WorkflowService-${shortdate}.log"
            createDirs="true"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="14"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner= ${exception:format=tostring}}" />
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="console,file" />
  </rules>
</nlog>
